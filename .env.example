# Eleven Views Platform — local configuration template
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# ---------------------------------------------------------------------------
# EVERY VITE_-PREFIXED VARIABLE IS COMPILED INTO BROWSER-DELIVERED JAVASCRIPT.
# Anyone who loads the portal can read it. Never put a credential behind a
# VITE_ prefix. Server credentials belong on the backend, reached through
# services/serverProxy.ts.
#
# vite.config.ts fails the build if a secret-shaped VITE_ variable is set.
# ---------------------------------------------------------------------------

# --- Public endpoints (safe to ship) ---
VITE_APP_URL=https://elevenviews.io
VITE_MCP_URL=https://mcp.elevenviews.io
VITE_AISIM_MCP_URL=https://aisim.elevenviews.io
VITE_AGENT_API_URL=https://app.elevenviews.io
VITE_N8N_API_URL=https://n8n.srv1167160.hstgr.cloud

# --- Supabase (anon key is publishable; RLS enforces access) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Non-secret service configuration ---
VITE_BASEROW_API_URL=https://api.baserow.io/api
VITE_BASEROW_TABLE_ID=
VITE_WASABI_REGION=us-east-1
VITE_WASABI_BUCKET=eleven-views-media
VITE_BOX_CLIENT_ID=
VITE_BOX_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Deliberately NOT listed here, because they must not exist in this file at all:
#
#   Resend API key, Wasabi access/secret pair, Google AI key, Baserow token,
#   Discord webhook URL, Box client secret, n8n API key, Vortex API key,
#   Supabase service-role key, Supabase database password.
#
# These are configured on the backend that serves the routes in
# services/serverProxy.ts (SERVER_ROUTES). If you need one of these features
# locally, point VITE_MCP_URL at a backend that has the credential.
# ---------------------------------------------------------------------------
